<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Barbatos.Pallas.DependencyInjection</RootNamespace>
    <Description>Barbatos.Pallas for Microsoft.Extensions.DependencyInjection: AddPallas(), validated options, and registration of function, constant and unit modules. Carries the reference data (CODATA 2022 constants, NIST SP 811 unit conversions, CIAAW atomic weights), the spreadsheet and number table, and function graphing.</Description>
  </PropertyGroup>

  <!--
    Published, on top of the Engine package. Data, Spreadsheet and Graphing are not published on their own, so they are
    referenced with PrivateAssets="all" - no package dependency on them - and the package carries their
    assemblies (Directory.Build.targets). Engine stays an ordinary reference: it is a package, and a dependency.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Barbatos.Pallas.DependencyInjection</PackageId>
    <PackageTags>dependencyinjection;di;microsoft-extensions;constants;codata;units;nist;spreadsheet;graphing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Barbatos.Pallas.Engine\Barbatos.Pallas.Engine.csproj" />
    <ProjectReference Include="..\Barbatos.Pallas.Data\Barbatos.Pallas.Data.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Barbatos.Pallas.Spreadsheet\Barbatos.Pallas.Spreadsheet.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Barbatos.Pallas.Graphing\Barbatos.Pallas.Graphing.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
