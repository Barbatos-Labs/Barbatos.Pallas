<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The presentation layer of the calculator: view models, the on-screen keypad model, the structural
    math-input editor and the calculator-app registry. It references no UI framework - Architecture.Tests
    enforces that - so every one of them is tested without a window.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Barbatos.Pallas.Presentation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Barbatos.Pallas.Engine\Barbatos.Pallas.Engine.csproj" />
    <!-- The Spreadsheet and Table screens: the sheet and the number table are those applications themselves. -->
    <ProjectReference Include="..\..\core\Barbatos.Pallas.Spreadsheet\Barbatos.Pallas.Spreadsheet.csproj" />
    <!-- The graph of the Table screen: its curves sampled, and its roots, extrema and intersections named. -->
    <ProjectReference Include="..\..\core\Barbatos.Pallas.Graphing\Barbatos.Pallas.Graphing.csproj" />
  </ItemGroup>

</Project>
