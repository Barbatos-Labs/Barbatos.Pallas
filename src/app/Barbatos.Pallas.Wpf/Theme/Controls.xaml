<!--
    Every control of the calculator, styled once here rather than in seventeen views.

    A key is drawn as a cap: rounded, with a thicker bottom edge that becomes a top edge while it is held down, so
    pressing it looks like pressing it. What colour a key is comes from its KeyGroup, which is part of the keypad
    table - the host keeps no second list of which key is a digit.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:presentation="clr-namespace:Barbatos.Pallas.Presentation;assembly=Barbatos.Pallas.Presentation">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ── Text ─────────────────────────────────────────────────────────────────────────────────────────────── -->

    <Style x:Key="ScreenTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- ── Panels ───────────────────────────────────────────────────────────────────────────────────────────── -->

    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource EdgeSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelCorner}" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- The display: the one pale surface in the window, which is where the mathematics is drawn. -->
    <Style x:Key="LcdPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Lcd}" />
        <Setter Property="BorderBrush" Value="{StaticResource LcdEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SmallCorner}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource LcdInk}" />
    </Style>

    <!-- ── Keys ─────────────────────────────────────────────────────────────────────────────────────────────── -->

    <Style x:Key="KeyButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource KeyFunctionFace}" />
        <Setter Property="Foreground" Value="{StaticResource KeyFunctionInk}" />
        <Setter Property="BorderBrush" Value="{StaticResource KeyLip}" />
        <Setter Property="BorderThickness" Value="{StaticResource KeyLipThickness}" />
        <Setter Property="FontSize" Value="{StaticResource KeySize}" />
        <Setter Property="MinHeight" Value="{StaticResource KeyHeight}" />
        <Setter Property="Margin" Value="2,1.5" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Cap"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource KeyCorner}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter Margin="2,2"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cap" Property="Background" Value="{StaticResource KeyHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Cap" Property="BorderThickness" Value="{StaticResource KeyLipPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Cap" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Group}" Value="Digit">
                <Setter Property="Background" Value="{StaticResource KeyDigitFace}" />
                <Setter Property="Foreground" Value="{StaticResource KeyDigitInk}" />
                <Setter Property="FontSize" Value="17" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Group}" Value="Operator">
                <Setter Property="Background" Value="{StaticResource KeyOperatorFace}" />
                <Setter Property="Foreground" Value="{StaticResource KeyOperatorInk}" />
                <Setter Property="FontSize" Value="17" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Group}" Value="Control">
                <Setter Property="Background" Value="{StaticResource KeyControlFace}" />
                <Setter Property="Foreground" Value="{StaticResource KeyControlInk}" />
                <Setter Property="FontSize" Value="13" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Group}" Value="Clear">
                <Setter Property="Background" Value="{StaticResource KeyClearFace}" />
                <Setter Property="Foreground" Value="{StaticResource KeyClearInk}" />
                <Setter Property="FontSize" Value="13" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Group}" Value="Modifier">
                <Setter Property="Background" Value="{StaticResource KeyModifierFace}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Group}" Value="Execute">
                <Setter Property="Background" Value="{StaticResource KeyExecuteFace}" />
                <Setter Property="Foreground" Value="{StaticResource KeyExecuteInk}" />
                <Setter Property="FontSize" Value="19" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <!-- The two keys the calculator prints in colour, because their legends are printed in it (p. 18). -->
            <DataTrigger Binding="{Binding Id}" Value="{x:Static presentation:KeyId.Shift}">
                <Setter Property="Foreground" Value="{StaticResource ShiftInk}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="{x:Static presentation:KeyId.Alpha}">
                <Setter Property="Foreground" Value="{StaticResource AlphaInk}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── Buttons that are not keys ────────────────────────────────────────────────────────────────────────── -->

    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SmallCorner}"
                            Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource KeyHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Bezel}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="#052B26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BackButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
    </Style>

    <!-- A tile on the home screen: one application, and whether this build can open it. -->
    <Style x:Key="AppTile" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource EdgeSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="MinHeight" Value="58" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource PanelCorner}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <Grid>
                            <Border x:Name="Stripe"
                                    Width="4"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource Accent}"
                                    CornerRadius="10,0,0,10" />
                            <ContentPresenter Margin="16,10,12,10" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceRaised}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Opacity" Value="0.4" />
                            <Setter TargetName="Stripe" Property="Background" Value="{StaticResource InkFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One calculation out of the history; pressing it puts it back on the line. -->
    <Style x:Key="HistoryItem" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="HistoryRow" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HistoryList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource HistoryRow}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- One cell of the sheet: its address above what it holds, and an outline when it is the selected one. -->
    <Style x:Key="SheetCell" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Face"
                            Margin="2"
                            Padding="6,4"
                            Background="{StaticResource SurfaceRaised}"
                            BorderBrush="{StaticResource EdgeSoft}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Edge}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Face" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SheetList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SheetCell}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- One line of what an application solved: its name, and what it came to. Four screens show the same shape. -->
    <DataTemplate x:Key="NamedValueRow">
        <DockPanel Margin="0,3">
            <TextBlock DockPanel.Dock="Left"
                       MinWidth="64"
                       FontFamily="{StaticResource MonoFont}"
                       Foreground="{StaticResource InkMuted}"
                       Text="{Binding Name}" />
            <TextBlock FontFamily="{StaticResource MonoFont}"
                       Foreground="{StaticResource Ink}"
                       TextWrapping="Wrap"
                       Text="{Binding Text}" />
        </DockPanel>
    </DataTemplate>

    <!-- ── Input ────────────────────────────────────────────────────────────────────────────────────────────── -->

    <Style x:Key="CellBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Face"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SmallCorner}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChoiceItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Face"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceRaised}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Choice" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinWidth" Value="130" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ChoiceItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Face"
                                            Background="{StaticResource SurfaceRaised}"
                                            BorderBrush="{StaticResource Edge}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource SmallCorner}" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Margin="10,5,26,5"
                                          IsHitTestVisible="False"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />

                        <Path Width="9"
                              Height="5"
                              Margin="0,0,10,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Data="M0,0 L9,0 L4.5,5 Z"
                              Fill="{StaticResource InkMuted}" />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               Focusable="False"
                               PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Margin="0,2,0,0"
                                    Background="{StaticResource Bezel}"
                                    BorderBrush="{StaticResource Edge}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource SmallCorner}"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Flag" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceRaised}"
                                BorderBrush="{StaticResource Edge}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Path x:Name="Tick"
                                  Margin="2"
                                  Stretch="Uniform"
                                  Visibility="Collapsed"
                                  Data="M0,4 L3,7 L8,1"
                                  Stroke="#052B26"
                                  StrokeThickness="2" />
                        </Border>
                        <ContentPresenter Margin="7,0,0,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
