<UserControl x:Class="Barbatos.Pallas.Wpf.Views.CalculateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             xmlns:aqr="http://schemas.barbatos.co/aquariusrouter/2026/xaml"
             xmlns:views="clr-namespace:Barbatos.Pallas.Wpf.Views">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left"
                    Padding="10,4"
                    Margin="0,0,12,0"
                    Focusable="False"
                    aqr:RouterLink.To="/"
                    Content="{i18n:StringLocalizer Text='settings.back'}" />
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{i18n:StringLocalizer BindText={Binding TitleKey}}" />
        </DockPanel>

        <views:CalculationPanelView DockPanel.Dock="Bottom" />

        <!-- Everything calculated before, newest first; clicking one puts it back on the line. -->
        <ListBox ItemsSource="{Binding History}"
                 BorderThickness="0"
                 Focusable="False"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            Padding="2"
                            Command="{Binding DataContext.RecallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       FontFamily="Consolas"
                                       Foreground="#333"
                                       Text="{Binding Display.Text}" />
                            <TextBlock FontFamily="Consolas"
                                       Foreground="Gray"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Input}" />
                        </DockPanel>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
