<UserControl x:Class="Barbatos.Pallas.Wpf.Views.CalculateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             xmlns:aqr="http://schemas.barbatos.co/aquariusrouter/2026/xaml"
             xmlns:views="clr-namespace:Barbatos.Pallas.Wpf.Views">
    <Grid Margin="14">
        <!-- The history and the calculator share what the header leaves, the calculator most of it and never more
             than its keys want; on a tall window the rest goes to the history. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" MinHeight="0" />
            <RowDefinition Height="6*" MaxHeight="{StaticResource PanelMaxHeight}" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource BackButton}"
                    aqr:RouterLink.To="/"
                    Content="{i18n:StringLocalizer Text='settings.back'}" />
            <TextBlock Style="{StaticResource ScreenTitle}"
                       Text="{i18n:StringLocalizer BindText={Binding TitleKey}}" />
        </DockPanel>

        <!-- Everything calculated before, newest first; clicking one puts it back on the line. It is this row that
             gives way when the window is short, never the display or the keys. -->
        <ListBox Grid.Row="1"
                 Style="{StaticResource HistoryList}"
                 Margin="0,0,0,8"
                 ItemsSource="{Binding History}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource HistoryItem}"
                            Command="{Binding DataContext.RecallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource Ink}"
                                       Text="{Binding Display.Text}" />
                            <TextBlock FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource InkMuted}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Input}" />
                        </DockPanel>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <views:CalculationPanelView Grid.Row="2" />
    </Grid>
</UserControl>
