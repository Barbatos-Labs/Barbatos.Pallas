<UserControl x:Class="Barbatos.Pallas.Wpf.Views.CalculateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             xmlns:aqr="http://schemas.barbatos.co/aquariusrouter/2026/xaml"
             xmlns:wpfmath="clr-namespace:WpfMath.Controls;assembly=WpfMath"
             xmlns:views="clr-namespace:Barbatos.Pallas.Wpf.Views">
    <UserControl.Resources>
        <Style x:Key="WhenResult" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasResult}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WhenError" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left"
                    Padding="10,4"
                    Margin="0,0,12,0"
                    Focusable="False"
                    aqr:RouterLink.To="/"
                    Content="{i18n:StringLocalizer Text='settings.back'}" />
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{i18n:StringLocalizer Text='app.calculate'}" />
        </DockPanel>

        <!-- What the calculation came to, or what went wrong with it. -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="#888"
                BorderThickness="1"
                Padding="8"
                Margin="0,8,0,0"
                MinHeight="56">
            <Grid>
                <DockPanel Style="{StaticResource WhenResult}" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"
                               FontSize="16"
                               Text="{Binding Display.Text}" />
                    <wpfmath:FormulaControl DockPanel.Dock="Left"
                                            Formula="{Binding Display.Latex}"
                                            Scale="20"
                                            VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource WhenError}"
                           VerticalAlignment="Center"
                           FontSize="15"
                           Foreground="#C00"
                           Text="{i18n:StringLocalizer BindText={Binding ErrorKey}}" />
            </Grid>
        </Border>

        <views:MathInputView DockPanel.Dock="Bottom" DataContext="{Binding Input}" />

        <!-- Everything calculated before, newest first; clicking one puts it back on the line. -->
        <ListBox ItemsSource="{Binding History}"
                 BorderThickness="0"
                 Focusable="False"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            Padding="2"
                            Command="{Binding DataContext.RecallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       FontFamily="Consolas"
                                       Foreground="#333"
                                       Text="{Binding Display.Text}" />
                            <TextBlock FontFamily="Consolas"
                                       Foreground="Gray"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Input}" />
                        </DockPanel>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
