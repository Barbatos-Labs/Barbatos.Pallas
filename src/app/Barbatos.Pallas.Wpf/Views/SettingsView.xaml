<UserControl x:Class="Barbatos.Pallas.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             xmlns:aqr="http://schemas.barbatos.co/aquariusrouter/2026/xaml"
             xmlns:vm="clr-namespace:Barbatos.Pallas.Presentation;assembly=Barbatos.Pallas.Presentation">
    <UserControl.Resources>
        <!-- An enum value is its own localization key, so one template serves every setting. -->
        <DataTemplate x:Key="SettingName">
            <TextBlock Text="{i18n:StringLocalizer BindText={Binding}, Namespace='setting'}" />
        </DataTemplate>
        <DataTemplate x:Key="NumberFormatName">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Kind}" />
                <TextBlock Text=" " />
                <TextBlock Text="{Binding Digits}" />
            </StackPanel>
        </DataTemplate>
        <Style TargetType="TextBlock" x:Key="Label" BasedOn="{StaticResource FieldLabel}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource Choice}">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="MinWidth" Value="180" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource Flag}">
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource BackButton}"
                    aqr:RouterLink.To="/"
                    Content="{i18n:StringLocalizer Text='settings.back'}" />
            <TextBlock Style="{StaticResource ScreenTitle}"
                       FontSize="22"
                       Text="{i18n:StringLocalizer Text='settings.title'}" />
        </DockPanel>

        <Button Grid.Row="2"
                Style="{StaticResource ActionButton}"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Command="{Binding ResetCommand}"
                Content="{i18n:StringLocalizer Text='settings.reset'}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}"
                           Text="{i18n:StringLocalizer Text='setting.inputOutput'}" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{x:Static vm:SettingsViewModel.InputOutputOptions}"
                          ItemTemplate="{StaticResource SettingName}"
                          SelectedItem="{Binding InputOutput}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}"
                           Text="{i18n:StringLocalizer Text='setting.angleUnit'}" />
                <ComboBox Grid.Row="1" Grid.Column="1"
                          ItemsSource="{x:Static vm:SettingsViewModel.AngleUnitOptions}"
                          ItemTemplate="{StaticResource SettingName}"
                          SelectedItem="{Binding AngleUnit}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}"
                           Text="{i18n:StringLocalizer Text='setting.numberFormat'}" />
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{x:Static vm:SettingsViewModel.NumberFormatOptions}"
                          ItemTemplate="{StaticResource NumberFormatName}"
                          SelectedItem="{Binding NumberFormat}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}"
                           Text="{i18n:StringLocalizer Text='setting.fractionResult'}" />
                <ComboBox Grid.Row="3" Grid.Column="1"
                          ItemsSource="{x:Static vm:SettingsViewModel.FractionResultOptions}"
                          ItemTemplate="{StaticResource SettingName}"
                          SelectedItem="{Binding FractionResult}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}"
                           Text="{i18n:StringLocalizer Text='setting.complexResult'}" />
                <ComboBox Grid.Row="4" Grid.Column="1"
                          ItemsSource="{x:Static vm:SettingsViewModel.ComplexResultOptions}"
                          ItemTemplate="{StaticResource SettingName}"
                          SelectedItem="{Binding ComplexResult}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Label}"
                           Text="{i18n:StringLocalizer Text='setting.decimalMark'}" />
                <ComboBox Grid.Row="5" Grid.Column="1"
                          ItemsSource="{x:Static vm:SettingsViewModel.DecimalMarkOptions}"
                          ItemTemplate="{StaticResource SettingName}"
                          SelectedItem="{Binding DecimalMark}" />

                <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,8,0,0">
                    <CheckBox IsChecked="{Binding EngineerSymbol}"
                              Content="{i18n:StringLocalizer Text='setting.engineerSymbol'}" />
                    <CheckBox IsChecked="{Binding DigitSeparator}"
                              Content="{i18n:StringLocalizer Text='setting.digitSeparator'}" />
                    <CheckBox IsChecked="{Binding ComplexRoots}"
                              Content="{i18n:StringLocalizer Text='setting.complexRoots'}" />
                    <CheckBox IsChecked="{Binding Verify}"
                              Content="{i18n:StringLocalizer Text='setting.verify'}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
