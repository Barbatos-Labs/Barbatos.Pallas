<UserControl x:Class="Barbatos.Pallas.Wpf.Views.VectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             xmlns:aqr="http://schemas.barbatos.co/aquariusrouter/2026/xaml"
             xmlns:views="clr-namespace:Barbatos.Pallas.Wpf.Views">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" MinHeight="0" />
            <RowDefinition Height="5*" MaxHeight="{StaticResource PanelMaxHeight}" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource BackButton}"
                    aqr:RouterLink.To="/"
                    Content="{i18n:StringLocalizer Text='settings.back'}" />
            <TextBlock Style="{StaticResource ScreenTitle}" Text="{i18n:StringLocalizer Text='app.vector'}" />
        </DockPanel>

        <StackPanel Grid.Row="1">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox Style="{StaticResource Choice}"
                          MinWidth="110"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding Names}"
                          SelectedItem="{Binding Name}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{i18n:StringLocalizer BindText={Binding}, Namespace='choice'}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Style="{StaticResource ActionButton}" Margin="0,0,8,0" Command="{Binding StoreCommand}" Content="{i18n:StringLocalizer Text='matrix.store'}" />
                <Button Style="{StaticResource ActionButton}" Margin="0,0,8,0" Command="{Binding DeleteCommand}" Content="{i18n:StringLocalizer Text='matrix.delete'}" />
                <Button Style="{StaticResource ActionButton}" Command="{Binding UseAnswerCommand}" Content="{i18n:StringLocalizer Text='matrix.answer'}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource PanelBorder}" VerticalAlignment="Top">
                <views:ValueGridView DataContext="{Binding Grid}" />
            </Border>
        </ScrollViewer>

        <views:CalculationPanelView Grid.Row="3" DataContext="{Binding Calculate}" />
    </Grid>
</UserControl>
