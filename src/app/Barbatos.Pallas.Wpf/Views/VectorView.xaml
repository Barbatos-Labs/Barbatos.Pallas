<UserControl x:Class="Barbatos.Pallas.Wpf.Views.VectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             xmlns:aqr="http://schemas.barbatos.co/aquariusrouter/2026/xaml"
             xmlns:views="clr-namespace:Barbatos.Pallas.Wpf.Views">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left"
                    Padding="10,4"
                    Margin="0,0,12,0"
                    Focusable="False"
                    aqr:RouterLink.To="/"
                    Content="{i18n:StringLocalizer Text='settings.back'}" />
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{i18n:StringLocalizer Text='app.vector'}" />
        </DockPanel>

        <views:CalculationPanelView DockPanel.Dock="Bottom" DataContext="{Binding Calculate}" />

        <StackPanel VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox MinWidth="110" Margin="0,0,8,0" ItemsSource="{Binding Names}" SelectedItem="{Binding Name}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{i18n:StringLocalizer BindText={Binding}, Namespace='choice'}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
                <Button Padding="10,4" Margin="0,0,8,0" Command="{Binding StoreCommand}" Content="{i18n:StringLocalizer Text='matrix.store'}" />
                <Button Padding="10,4" Margin="0,0,8,0" Command="{Binding DeleteCommand}" Content="{i18n:StringLocalizer Text='matrix.delete'}" />
                <Button Padding="10,4" Command="{Binding UseAnswerCommand}" Content="{i18n:StringLocalizer Text='matrix.answer'}" />
            </StackPanel>
            <views:ValueGridView DataContext="{Binding Grid}" />
        </StackPanel>
    </DockPanel>
</UserControl>
