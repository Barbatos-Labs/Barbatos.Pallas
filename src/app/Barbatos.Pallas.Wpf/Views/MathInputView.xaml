<UserControl x:Class="Barbatos.Pallas.Wpf.Views.MathInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpfmath="clr-namespace:WpfMath.Controls;assembly=WpfMath"
             Focusable="True">
    <DockPanel>
        <!-- The keypad, row by row, straight from the table: a new key is a row in Keypad, not a button here. -->
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Rows}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="2"
                                        Padding="2,6"
                                        MinHeight="44"
                                        Focusable="False"
                                        Command="{Binding DataContext.PressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ShiftGlyph}"
                                                   FontSize="9"
                                                   Foreground="#C77"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Glyph}"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding AlphaGlyph}"
                                                   FontSize="9"
                                                   Foreground="#77C"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border BorderBrush="#888" BorderThickness="1" Padding="8" MinHeight="96">
            <DockPanel>
                <!-- What the engine will read, under what the screen shows: the two are the same tree. -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding Linear}"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="Gray"
                           TextWrapping="Wrap" />
                <wpfmath:FormulaControl Formula="{Binding Latex}"
                                        Scale="22"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
