<UserControl x:Class="Barbatos.Pallas.Wpf.Views.BusyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             Style="{StaticResource BusyCover}">
    <Border Style="{StaticResource BusyPanel}">
        <StackPanel>
            <TextBlock Style="{StaticResource LcdText}"
                       HorizontalAlignment="Center"
                       Text="{i18n:StringLocalizer Text='busy.calculating'}" />
            <Button Style="{StaticResource ActionButton}"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Command="{Binding CancelCommand}"
                    Content="{i18n:StringLocalizer Text='busy.stop'}" />
        </StackPanel>
    </Border>
</UserControl>
