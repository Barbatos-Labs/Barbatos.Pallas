<UserControl x:Class="Barbatos.Pallas.Wpf.Views.CalculationPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             xmlns:wpfmath="clr-namespace:WpfMath.Controls;assembly=WpfMath"
             xmlns:presentation="clr-namespace:Barbatos.Pallas.Presentation;assembly=Barbatos.Pallas.Presentation"
             xmlns:views="clr-namespace:Barbatos.Pallas.Wpf.Views">
    <UserControl.Resources>
        <Style x:Key="WhenResult" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasResult}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WhenError" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
        The display takes the height it needs and the keypad the rest, which its rows share: the screen decides how
        much this panel gets, and the keys grow or shrink with it. A DockPanel gave the keypad its height first and
        squeezed everything else out of the window, and an Auto keypad of ten rows lost its last row off the bottom
        (both measured 23 Sep 2026).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- One display, as the calculator has one: what is being typed, and under it what it came to. -->
        <Border Grid.Row="0" Style="{StaticResource LcdPanel}" MinHeight="124" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="40" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MinHeight="34" />
                </Grid.RowDefinitions>

                <wpfmath:FormulaControl Grid.Row="0"
                                        Formula="{Binding Input.Latex}"
                                        Scale="22"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />

                <!-- What the next key will mean, as the calculator marks it at the top of its display (p. 18), and
                     what the last STO did. -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            TextElement.FontSize="11"
                            TextElement.FontWeight="SemiBold">
                    <TextBlock Margin="0,0,8,0" Foreground="{StaticResource LcdInkMuted}" FontFamily="{StaticResource MonoFont}" Text="{Binding Notice}" />
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Input.Mode}" Value="{x:Static presentation:KeyMode.Shift}">
                                        <Setter Property="Text" Value="S" />
                                        <Setter Property="Foreground" Value="{StaticResource LcdShift}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Input.Mode}" Value="{x:Static presentation:KeyMode.Alpha}">
                                        <Setter Property="Text" Value="A" />
                                        <Setter Property="Foreground" Value="{StaticResource LcdAlpha}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Input.Mode}" Value="{x:Static presentation:KeyMode.Store}">
                                        <Setter Property="Text" Value="STO" />
                                        <Setter Property="Foreground" Value="{StaticResource LcdShift}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- What the engine will read, under what the screen shows: the two are the same tree. -->
                <TextBlock Grid.Row="1"
                           Text="{Binding Input.Linear}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="10"
                           Foreground="{StaticResource LcdInkMuted}"
                           TextWrapping="Wrap" />

                <Border Grid.Row="2"
                        Height="1"
                        Margin="0,6,0,4"
                        Background="{StaticResource LcdEdge}"
                        Opacity="0.5" />

                <Grid Grid.Row="3">
                    <DockPanel Style="{StaticResource WhenResult}" LastChildFill="False">
                        <wpfmath:FormulaControl DockPanel.Dock="Right"
                                                Formula="{Binding Display.Latex}"
                                                Scale="26"
                                                VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding Display.Text}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource LcdInkMuted}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource WhenError}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource LcdError}"
                               Text="{i18n:StringLocalizer BindText={Binding ErrorKey}}" />
                </Grid>
            </Grid>
        </Border>

        <views:KeypadView x:Name="Keys" Grid.Row="1" DataContext="{Binding Input}" />

        <!-- A menu is drawn over the keys it was opened from, as the calculator draws it on its display. -->
        <views:CalculatorMenuView x:Name="Menu" Grid.Row="1">
            <views:CalculatorMenuView.Style>
                <Style TargetType="views:CalculatorMenuView">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Menu}" Value="{x:Static presentation:CalculatorMenu.None}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:CalculatorMenuView.Style>
        </views:CalculatorMenuView>
    </Grid>
</UserControl>
