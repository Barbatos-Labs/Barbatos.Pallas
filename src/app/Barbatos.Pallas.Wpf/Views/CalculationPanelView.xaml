<UserControl x:Class="Barbatos.Pallas.Wpf.Views.CalculationPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             xmlns:wpfmath="clr-namespace:WpfMath.Controls;assembly=WpfMath"
             xmlns:views="clr-namespace:Barbatos.Pallas.Wpf.Views">
    <UserControl.Resources>
        <Style x:Key="WhenResult" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasResult}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WhenError" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
        The display takes the height it needs and the keypad the rest, which its rows share: the screen decides how
        much this panel gets, and the keys grow or shrink with it. A DockPanel gave the keypad its height first and
        squeezed everything else out of the window, and an Auto keypad of ten rows lost its last row off the bottom
        (both measured 23 Sep 2026).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- One display, as the calculator has one: what is being typed, and under it what it came to. -->
        <Border Grid.Row="0" Style="{StaticResource LcdPanel}" MinHeight="124" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="40" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MinHeight="34" />
                </Grid.RowDefinitions>

                <wpfmath:FormulaControl Grid.Row="0"
                                        Formula="{Binding Input.Latex}"
                                        Scale="22"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />

                <!-- What the engine will read, under what the screen shows: the two are the same tree. -->
                <TextBlock Grid.Row="1"
                           Text="{Binding Input.Linear}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="10"
                           Foreground="{StaticResource LcdInkMuted}"
                           TextWrapping="Wrap" />

                <Border Grid.Row="2"
                        Height="1"
                        Margin="0,6,0,4"
                        Background="{StaticResource LcdEdge}"
                        Opacity="0.5" />

                <Grid Grid.Row="3">
                    <DockPanel Style="{StaticResource WhenResult}" LastChildFill="False">
                        <wpfmath:FormulaControl DockPanel.Dock="Right"
                                                Formula="{Binding Display.Latex}"
                                                Scale="26"
                                                VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding Display.Text}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource LcdInkMuted}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource WhenError}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource LcdError}"
                               Text="{i18n:StringLocalizer BindText={Binding ErrorKey}}" />
                </Grid>
            </Grid>
        </Border>

        <views:KeypadView Grid.Row="1" DataContext="{Binding Input}" />
    </Grid>
</UserControl>
