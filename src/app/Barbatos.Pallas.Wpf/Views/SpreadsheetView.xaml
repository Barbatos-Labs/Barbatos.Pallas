<UserControl x:Class="Barbatos.Pallas.Wpf.Views.SpreadsheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             xmlns:aqr="http://schemas.barbatos.co/aquariusrouter/2026/xaml"
             xmlns:views="clr-namespace:Barbatos.Pallas.Wpf.Views">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left"
                    Padding="10,4"
                    Margin="0,0,12,0"
                    Focusable="False"
                    aqr:RouterLink.To="/"
                    Content="{i18n:StringLocalizer Text='settings.back'}" />
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{i18n:StringLocalizer Text='app.spreadsheet'}" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Foreground="#C00" Margin="0,6,0,0" Text="{i18n:StringLocalizer BindText={Binding ErrorKey}}" />

        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Consolas" Text="{Binding Selected}" />
                    <TextBox Width="220" Padding="4,3" FontFamily="Consolas" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Padding="10,4" Margin="8,0,0,0" Command="{Binding CommitCommand}" Content="{i18n:StringLocalizer Text='sheet.commit'}" />
                    <Button Padding="10,4" Margin="8,0,0,0" Command="{Binding ClearCellCommand}" Content="{i18n:StringLocalizer Text='sheet.clearCell'}" />
                    <Button Padding="10,4" Margin="8,0,0,0" Command="{Binding ClearAllCommand}" Content="{i18n:StringLocalizer Text='sheet.clearAll'}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="{Binding AutoCalculate}" Content="{i18n:StringLocalizer Text='sheet.auto'}" />
                    <Button Padding="10,4" Margin="0,0,12,0" Command="{Binding RecalculateCommand}" Content="{i18n:StringLocalizer Text='sheet.recalculate'}" />
                    <TextBlock VerticalAlignment="Center" Foreground="Gray" Text="{Binding UsedBytes}" />
                </StackPanel>
            </StackPanel>

            <ListBox ItemsSource="{Binding Cells}"
                     SelectedValuePath="Address"
                     SelectedValue="{Binding Selected}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns}" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel MinWidth="70">
                            <TextBlock FontSize="9" Foreground="Gray" Text="{Binding Address}" />
                            <TextBlock FontFamily="Consolas" Text="{Binding Text}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</UserControl>
