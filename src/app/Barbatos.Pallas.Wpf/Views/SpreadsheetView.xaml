<UserControl x:Class="Barbatos.Pallas.Wpf.Views.SpreadsheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             xmlns:aqr="http://schemas.barbatos.co/aquariusrouter/2026/xaml">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource BackButton}"
                    aqr:RouterLink.To="/"
                    Content="{i18n:StringLocalizer Text='settings.back'}" />
            <TextBlock Style="{StaticResource ScreenTitle}" Text="{i18n:StringLocalizer Text='app.spreadsheet'}" />
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left"
                           MinWidth="34"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}"
                           Text="{Binding Selected}" />
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,2,0,2"
                        Command="{Binding CommitCommand}"
                        Content="{i18n:StringLocalizer Text='sheet.commit'}" />
                <TextBox Style="{StaticResource CellBox}"
                         TextAlignment="Left"
                         Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <StackPanel Orientation="Horizontal">
                <CheckBox Style="{StaticResource Flag}" IsChecked="{Binding AutoCalculate}" Content="{i18n:StringLocalizer Text='sheet.auto'}" />
                <Button Style="{StaticResource ActionButton}" Margin="0,2,8,2" Command="{Binding RecalculateCommand}" Content="{i18n:StringLocalizer Text='sheet.recalculate'}" />
                <Button Style="{StaticResource ActionButton}" Margin="0,2,8,2" Command="{Binding ClearCellCommand}" Content="{i18n:StringLocalizer Text='sheet.clearCell'}" />
                <Button Style="{StaticResource ActionButton}" Margin="0,2,8,2" Command="{Binding ClearAllCommand}" Content="{i18n:StringLocalizer Text='sheet.clearAll'}" />
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource InkFaint}" Text="{Binding UsedBytes}" />
            </StackPanel>
        </StackPanel>

        <ListBox Grid.Row="2"
                 Style="{StaticResource SheetList}"
                 ItemsSource="{Binding Cells}"
                 SelectedValuePath="Address"
                 SelectedValue="{Binding Selected}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Columns}" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel MinWidth="64">
                        <TextBlock FontSize="9" Foreground="{StaticResource InkFaint}" Text="{Binding Address}" />
                        <TextBlock FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource Ink}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Text}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Foreground="{StaticResource Danger}"
                   Text="{i18n:StringLocalizer BindText={Binding ErrorKey}}" />
    </Grid>
</UserControl>
