<UserControl x:Class="Barbatos.Pallas.Wpf.Views.AppScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             xmlns:aqr="http://schemas.barbatos.co/aquariusrouter/2026/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource BackButton}"
                    aqr:RouterLink.To="/"
                    Content="{i18n:StringLocalizer Text='settings.back'}" />
            <TextBlock Style="{StaticResource ScreenTitle}"
                       Text="{i18n:StringLocalizer BindText={Binding CurrentApp.NameKey}}" />
        </DockPanel>

        <TextBlock Grid.Row="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource InkFaint}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Text="{i18n:StringLocalizer Text='app.screenLater'}" />
    </Grid>
</UserControl>
