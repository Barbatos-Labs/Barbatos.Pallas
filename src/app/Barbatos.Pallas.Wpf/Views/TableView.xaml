<UserControl x:Class="Barbatos.Pallas.Wpf.Views.TableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             xmlns:aqr="http://schemas.barbatos.co/aquariusrouter/2026/xaml"
             xmlns:views="clr-namespace:Barbatos.Pallas.Wpf.Views">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left"
                    Padding="10,4"
                    Margin="0,0,12,0"
                    Focusable="False"
                    aqr:RouterLink.To="/"
                    Content="{i18n:StringLocalizer Text='settings.back'}" />
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{i18n:StringLocalizer Text='app.table'}" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Foreground="#C00" Margin="0,6,0,0" Text="{i18n:StringLocalizer BindText={Binding ErrorKey}}" />

        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox MinWidth="150" Margin="0,0,8,0" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{i18n:StringLocalizer BindText={Binding}, Namespace='choice'}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
                    <Button Padding="10,4" Margin="8,0,0,0" Command="{Binding GenerateCommand}" Content="{i18n:StringLocalizer Text='table.generate'}" />
                    <Button Padding="10,4" Margin="8,0,0,0" Command="{Binding ClearCommand}" Content="{i18n:StringLocalizer Text='equation.clear'}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,4,0" Text="f(x)" />
                    <TextBox Width="140" Padding="4,3" Margin="0,0,12,0" FontFamily="Consolas" Text="{Binding FunctionF, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center" Margin="0,0,4,0" Text="g(x)" />
                    <TextBox Width="140" Padding="4,3" FontFamily="Consolas" Text="{Binding FunctionG, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <TextBlock Margin="0,0,0,4" Foreground="Gray" Text="{i18n:StringLocalizer Text='table.range'}" />
                <views:ValueGridView DataContext="{Binding Range}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <TextBlock DockPanel.Dock="Left" MinWidth="80" FontFamily="Consolas" Foreground="Gray" Text="{Binding X.Display.Text}" />
                            <TextBlock DockPanel.Dock="Left" MinWidth="110" FontFamily="Consolas" Text="{Binding F.Display.Text}" />
                            <TextBlock FontFamily="Consolas" Text="{Binding G.Display.Text}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </DockPanel>
</UserControl>
