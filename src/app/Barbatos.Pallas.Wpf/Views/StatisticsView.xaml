<UserControl x:Class="Barbatos.Pallas.Wpf.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             xmlns:aqr="http://schemas.barbatos.co/aquariusrouter/2026/xaml"
             xmlns:views="clr-namespace:Barbatos.Pallas.Wpf.Views">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left"
                    Padding="10,4"
                    Margin="0,0,12,0"
                    Focusable="False"
                    aqr:RouterLink.To="/"
                    Content="{i18n:StringLocalizer Text='settings.back'}" />
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{i18n:StringLocalizer Text='app.statistics'}" />
        </DockPanel>

        <views:CalculationPanelView DockPanel.Dock="Bottom" DataContext="{Binding Calculate}" />

        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="{Binding IsTwoVariable}" Content="{i18n:StringLocalizer Text='statistics.twoVariable'}" />
                    <CheckBox VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="{Binding HasFrequencies}" Content="{i18n:StringLocalizer Text='statistics.frequencies'}" />
                    <ComboBox MinWidth="150" Margin="0,0,8,0" ItemsSource="{Binding Regressions}" SelectedItem="{Binding Regression}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{i18n:StringLocalizer BindText={Binding}, Namespace='choice'}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Padding="10,4" Margin="0,0,8,0" Command="{Binding ApplyCommand}" Content="{i18n:StringLocalizer Text='statistics.apply'}" />
                    <Button Padding="10,4" Margin="0,0,8,0" Command="{Binding AddRowCommand}" Content="{i18n:StringLocalizer Text='statistics.addRow'}" />
                    <Button Padding="10,4" Margin="0,0,8,0" Command="{Binding RemoveRowCommand}" Content="{i18n:StringLocalizer Text='statistics.removeRow'}" />
                    <Button Padding="10,4" Command="{Binding ClearCommand}" Content="{i18n:StringLocalizer Text='equation.clear'}" />
                </StackPanel>
                <views:ValueGridView DataContext="{Binding Data}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <ItemsControl ItemsSource="{Binding Summary}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <TextBlock DockPanel.Dock="Left" MinWidth="64" FontFamily="Consolas" Foreground="Gray" Text="{Binding Name}" />
                            <TextBlock FontFamily="Consolas" Text="{Binding Text}" TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</UserControl>
