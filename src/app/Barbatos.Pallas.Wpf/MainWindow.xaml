<Window x:Class="Barbatos.Pallas.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:aqr="http://schemas.barbatos.co/aquariusrouter/2026/xaml"
        xmlns:views="clr-namespace:Barbatos.Pallas.Wpf.Views"
        Title="Barbatos Pallas"
        Width="470" Height="880"
        MinWidth="410" MinHeight="700"
        Background="{StaticResource Body}"
        TextElement.Foreground="{StaticResource Ink}"
        TextElement.FontSize="{StaticResource BodySize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <aqr:RouterView />

        <!-- Over the screen while the session calculates: it takes the clicks, and says so once it has taken a while. -->
        <views:BusyView x:Name="Busy" />
    </Grid>
</Window>
