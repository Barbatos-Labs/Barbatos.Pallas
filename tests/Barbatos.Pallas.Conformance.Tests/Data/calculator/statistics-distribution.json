{
  "source": "User's guide of the reference calculator, Vietnamese edition (SA2207-A)",
  "chapter": "Statistics and Distribution applications (pp. 79-100)",
  "cases": [
    { "id": "stats-sort-001", "page": 83, "app": "Statistics", "kind": "statistics", "status": "ready",
      "given": {
        "mode": "2-Variable",
        "rows": [ [ "170", "66" ], [ "179", "75" ], [ "173", "68" ] ],
        "operations": [ "Sort x Ascending" ]
      },
      "expect": { "rows": [ [ "170", "66" ], [ "173", "68" ], [ "179", "75" ] ] }, "expectationSource": "derived-exact" },
    { "id": "stats-sort-002", "page": 83, "app": "Statistics", "kind": "statistics", "status": "ready",
      "given": {
        "mode": "2-Variable",
        "rows": [ [ "170", "66" ], [ "179", "75" ], [ "173", "68" ] ],
        "operations": [ "Sort x Ascending", "Sort y Descending" ]
      },
      "expect": { "rows": [ [ "179", "75" ], [ "173", "68" ], [ "170", "66" ] ] }, "expectationSource": "derived-exact" },

    { "id": "stats-1var-001", "page": 83, "app": "Statistics", "kind": "statistics", "status": "ready",
      "settings": { "frequency": "On" },
      "given": {
        "mode": "1-Variable",
        "columns": [ "x", "Freq" ],
        "rows": [ [ "1", "1" ], [ "2", "2" ], [ "3", "1" ], [ "4", "2" ], [ "5", "2" ], [ "6", "2" ], [ "7", "3" ], [ "8", "4" ], [ "9", "2" ], [ "10", "1" ] ]
      },
      "expect": {
        "n": "20", "Σx": "119", "Σx²": "837", "x̄": "5.95",
        "σ²x": "6.4475", "σx": "2.539192785", "s²x": "6.786842105", "sx": "2.605156829",
        "min(x)": "1", "max(x)": "10", "Q1": "4", "Med": "6.5", "Q3": "8"
      },
      "expectationSource": "derived-exact",
      "note": "Derived with exact rational arithmetic and integer square roots. Q1, Med and Q3 are the values the 1-Var Results screen of p. 84 shows, which the quartile rule of assumption U1 gives." },
    { "id": "stats-1var-normdist-001", "page": 91, "app": "Statistics", "kind": "statistics", "status": "ready",
      "given": { "sameDataAs": "stats-1var-001", "inputs": [ "2▶t", "P(Ans)" ] },
      "expect": { "values": { "2▶t": "-1.555612486", "P(Ans)": "0.05990013396" } }, "expectationSource": "reference",
      "note": "t = (2 − 5.95)/√(2579/400) = −79/√2579 = −1.55561248564866246429…; P(t) = Φ(t) = 0.05990013396322900464…, Ans holding t unrounded." },

    { "id": "stats-2var-001", "page": 84, "app": "Statistics", "kind": "statistics", "status": "ready",
      "given": {
        "mode": "2-Variable",
