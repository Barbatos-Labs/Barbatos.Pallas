{
  "source": "User's guide of the reference calculator, Vietnamese edition (SA2207-A)",
  "chapter": "Matrix and Vector applications (pp. 132-145)",
  "cases": [
    { "id": "matrix-multiply-001", "page": 132, "app": "Matrix", "kind": "expression", "status": "ready",
      "given": { "matrices": { "MatA": [ [ "2", "1" ], [ "1", "1" ] ], "MatB": [ [ "2", "-1" ], [ "-1", "2" ] ] } },
      "input": "MatA×MatB", "expect": { "matrix": [ [ "3", "0" ], [ "1", "1" ] ] }, "expectationSource": "derived-exact",
      "note": "Elements reconstructed from the key sequences on p. 133." },
    { "id": "matrix-add-001", "page": 137, "app": "Matrix", "kind": "expression", "status": "needs-visual-check",
      "given": { "matrices": { "MatA": [ [ "2", "1" ], [ "1", "1" ] ], "MatB": [ [ "2", "-1" ], [ "-1", "2" ] ] } },
      "input": "MatA+MatB", "expect": { "matrix": [ [ "4", "0" ], [ "0", "3" ] ] }, "expectationSource": "derived-exact",
      "note": "Examples 3-9 show MatA-MatD only as images on p. 137; assumed equal to the matrices entered in Examples 1-2." },
    { "id": "matrix-square-001", "page": 137, "app": "Matrix", "kind": "expression", "status": "needs-visual-check",
      "given": { "matrices": { "MatA": [ [ "2", "1" ], [ "1", "1" ] ] } },
      "input": "MatA²", "expect": { "matrix": [ [ "5", "3" ], [ "3", "2" ] ] }, "expectationSource": "derived-exact",
      "note": "MatA is shown only as an image on p. 137; assumed equal to the MatA entered in Example 1 (p. 133)." },
    { "id": "matrix-cube-001", "page": 137, "app": "Matrix", "kind": "expression", "status": "needs-visual-check",
      "given": { "matrices": { "MatA": [ [ "2", "1" ], [ "1", "1" ] ] } },
      "input": "MatA³", "expect": { "matrix": [ [ "13", "8" ], [ "8", "5" ] ] }, "expectationSource": "derived-exact",
      "note": "MatA is shown only as an image on p. 137; assumed equal to the MatA entered in Example 1 (p. 133)." },
    { "id": "matrix-inverse-001", "page": 137, "app": "Matrix", "kind": "expression", "status": "needs-visual-check",
      "given": { "matrices": { "MatA": [ [ "2", "1" ], [ "1", "1" ] ] } },
      "input": "MatA⁻¹", "expect": { "matrix": [ [ "1", "-1" ], [ "-1", "2" ] ] }, "expectationSource": "derived-exact",
      "note": "MatA is shown only as an image on p. 137; assumed equal to the MatA entered in Example 1 (p. 133)." },
    { "id": "matrix-determinant-001", "page": 138, "app": "Matrix", "kind": "expression", "status": "needs-visual-check",
      "given": { "matrices": { "MatA": [ [ "2", "1" ], [ "1", "1" ] ] } },
      "input": "Det(MatA)", "expect": { "result": "1" }, "expectationSource": "derived-exact",
      "note": "MatA is shown only as an image on p. 137; assumed equal to the MatA entered in Example 1 (p. 133)." },
    { "id": "matrix-transpose-001", "page": 138, "app": "Matrix", "kind": "expression", "status": "needs-visual-check",
      "given": { "matrices": { "MatC": [ [ "1", "0", "-1" ], [ "0", "-1", "1" ] ] } },
      "input": "Trn(MatC)", "expect": { "matrix": [ [ "1", "0" ], [ "0", "-1" ], [ "-1", "1" ] ] }, "expectationSource": "derived-exact",
      "note": "MatC assumed to be the 2×3 matrix entered in Example 2 (p. 135)." },
    { "id": "matrix-identity-001", "page": 139, "app": "Matrix", "kind": "expression", "status": "needs-visual-check",
      "given": { "matrices": { "MatA": [ [ "2", "1" ], [ "1", "1" ] ] } },
      "input": "Identity(2)+MatA", "expect": { "matrix": [ [ "3", "1" ], [ "1", "2" ] ] }, "expectationSource": "derived-exact",
      "note": "MatA is shown only as an image on p. 137; assumed equal to the MatA entered in Example 1 (p. 133)." },
    { "id": "matrix-abs-001", "page": 139, "app": "Matrix", "kind": "expression", "status": "needs-visual-check",
      "given": { "matrices": { "MatC": [ [ "1", "0", "-1" ], [ "0", "-1", "1" ] ] } },
      "input": "Abs(MatC)", "expect": { "matrix": [ [ "1", "0", "1" ], [ "0", "1", "1" ] ] }, "expectationSource": "derived-exact",
      "note": "MatC is shown only as an image on p. 137; assumed equal to the 2×3 matrix entered in Example 2 (p. 135)." },
    { "id": "matrix-dimension-error-001", "page": 137, "app": "Matrix", "kind": "expression", "status": "ready",
      "given": { "matrices": { "MatA": [ [ "2", "1" ], [ "1", "1" ] ], "MatC": [ [ "1", "0", "-1" ], [ "0", "-1", "1" ] ] } },
      "input": "MatA+MatC", "expect": { "error": "DimensionError" }, "expectationSource": "manual",
      "note": "Matrices of different sizes cannot be added." },
    { "id": "matrix-singular-001", "page": 138, "app": "Matrix", "kind": "expression", "status": "ready",
      "given": { "matrices": { "MatA": [ [ "1", "2" ], [ "2", "4" ] ] } },
      "input": "MatA⁻¹", "expect": { "error": "MathError" }, "expectationSource": "manual",
      "note": "A matrix with determinant zero cannot be inverted." },

    { "id": "vector-add-001", "page": 139, "app": "Vector", "kind": "expression", "status": "ready",
      "given": { "vectors": { "VctA": [ "1", "2" ], "VctB": [ "3", "4" ] } },
      "input": "VctA+VctB", "expect": { "vector": [ "4", "6" ] }, "expectationSource": "derived-exact" },
    { "id": "vector-dot-001", "page": 144, "app": "Vector", "kind": "expression", "status": "ready",
      "given": { "vectors": { "VctA": [ "1", "2" ], "VctB": [ "3", "4" ] } },
      "input": "VctA•VctB", "expect": { "result": "11" }, "expectationSource": "derived-exact" },
    { "id": "vector-cross-001", "page": 144, "app": "Vector", "kind": "expression", "status": "ready",
      "given": { "vectors": { "VctA": [ "1", "2" ], "VctB": [ "3", "4" ] } },
      "input": "VctA×VctB", "expect": { "vector": [ "0", "0", "-2" ] }, "expectationSource": "derived-exact",
      "note": "Two-dimensional vectors are crossed as (x, y, 0)." },
    { "id": "vector-angle-001", "page": 145, "app": "Vector", "kind": "expression", "status": "ready",
      "settings": { "numberFormat": "Fix3", "angleUnit": "Degree" },
      "given": { "vectors": { "VctA": [ "1", "2" ], "VctB": [ "3", "4" ] } },
      "input": "Angle(VctA,VctB)", "expect": { "result": "10.305" }, "expectationSource": "reference",
      "note": "arccos(11/(5√5)) = arctan(2/11) = 10.30484646876603194528…°." },
    { "id": "vector-unit-001", "page": 145, "app": "Vector", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO" },
      "given": { "vectors": { "VctB": [ "3", "4" ] } },
      "input": "UnitV(VctB)", "expect": { "vector": [ "3⌟5", "4⌟5" ] }, "expectationSource": "derived-exact" },
    { "id": "vector-abs-001", "page": 145, "app": "Vector", "kind": "expression", "status": "ready",
      "given": { "vectors": { "VctC": [ "2", "-1", "2" ] } },
      "input": "Abs(VctC)", "expect": { "result": "3" }, "expectationSource": "derived-exact" }
  ]
}
