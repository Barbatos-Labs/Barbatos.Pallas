{
  "source": "User's guide of the reference calculator, Vietnamese edition (SA2207-A)",
  "chapter": "Verify in the Calculate application (pp. 73-76)",
  "cases": [
    { "id": "verify-001", "page": 75, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" },
      "input": "4√(9)=12", "expect": { "verify": "True", "variables": { "Ans": "1" } }, "expectationSource": "derived-exact" },
    { "id": "verify-002", "page": 75, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" },
      "input": "0<(8⌟9)²-8⌟9", "expect": { "verify": "False", "variables": { "Ans": "0" } }, "expectationSource": "derived-exact",
      "note": "(8/9)² - 8/9 = -8/81." },
    { "id": "verify-003", "page": 75, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" }, "input": "4=√(16)", "expect": { "verify": "True" }, "expectationSource": "derived-exact" },
    { "id": "verify-004", "page": 75, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" }, "input": "4≠3", "expect": { "verify": "True" }, "expectationSource": "derived-exact" },
    { "id": "verify-005", "page": 75, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" }, "input": "π>3", "expect": { "verify": "True" }, "expectationSource": "derived-exact" },
    { "id": "verify-006", "page": 75, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" }, "input": "1+2≤5", "expect": { "verify": "True" }, "expectationSource": "derived-exact" },
    { "id": "verify-007", "page": 75, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" }, "input": "(3×6)<(2+6)×2", "expect": { "verify": "False" }, "expectationSource": "derived-exact",
      "note": "18 < 16 is false." },
    { "id": "verify-chain-001", "page": 75, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" }, "input": "1≤1<1+1", "expect": { "verify": "True" }, "expectationSource": "derived-exact" },
    { "id": "verify-chain-002", "page": 75, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" }, "input": "3<π<4", "expect": { "verify": "True" }, "expectationSource": "derived-exact" },
    { "id": "verify-chain-003", "page": 75, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" }, "input": "2²=2+2=4", "expect": { "verify": "True" }, "expectationSource": "derived-exact" },
    { "id": "verify-chain-004", "page": 75, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" }, "input": "2+3=5≠2+5=8", "expect": { "verify": "False" }, "expectationSource": "derived-exact",
      "note": "Listed as a verifiable form; the last link 2+5 = 8 is false." },
    { "id": "verify-syntax-001", "page": 75, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" }, "input": "5≤6≥4", "expect": { "error": "SyntaxError" }, "expectationSource": "manual",
      "note": "Relational operators pointing in different directions." },
    { "id": "verify-syntax-002", "page": 75, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" }, "input": "4<6≠8", "expect": { "error": "SyntaxError" }, "expectationSource": "manual" },
    { "id": "verify-continue-001", "page": 76, "app": "Calculate", "kind": "sequence", "status": "ready",
      "settings": { "verify": "On" },
      "steps": [
        { "input": "(x+1)(x+5)=x²+x+5x+5", "expect": { "verify": "True" } },
        { "input": "x²+x+5x+5=x²+6x+5", "expect": { "verify": "True" } }
      ], "expectationSource": "derived-exact",
      "note": "Verify evaluates with the value currently stored in x; both identities hold for every x." },
    { "id": "verify-no-operator-001", "page": 166, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" }, "input": "5", "expect": { "error": "NoOperator" }, "expectationSource": "manual" }
  ]
}
