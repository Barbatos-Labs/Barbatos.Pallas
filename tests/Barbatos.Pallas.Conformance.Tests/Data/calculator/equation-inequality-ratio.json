{
  "source": "User's guide of the reference calculator, Vietnamese edition (SA2207-A)",
  "chapter": "Equation, Inequality and Ratio applications (pp. 114-125, 145-146)",
  "cases": [
    { "id": "equation-simultaneous-001", "page": 114, "app": "Equation", "kind": "simultaneous", "status": "ready",
      "given": { "unknowns": 3, "coefficients": [ [ "1", "-1", "1", "2" ], [ "1", "1", "-1", "0" ], [ "-1", "1", "1", "4" ] ] },
      "expect": { "solution": { "x": "1", "y": "2", "z": "3" } }, "expectationSource": "derived-exact",
      "note": "Coefficients reconstructed from the key sequence on p. 115." },
    { "id": "equation-polynomial-001", "page": 116, "app": "Equation", "kind": "polynomial", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO" },
      "given": { "degree": 2, "coefficients": [ "1", "2", "-2" ] },
      "expect": { "roots": [ "-1+√(3)", "-1-√(3)" ], "extremum": { "type": "Min", "x": "-1", "y": "-3" } },
      "expectationSource": "manual", "note": "Roots and minimum are stated by the Verify example on pp. 122-123." },
    { "id": "equation-polynomial-002", "page": 118, "app": "Equation", "kind": "polynomial", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO", "complexResult": "a+bi", "complexRoots": "On" },
      "given": { "degree": 2, "coefficients": [ "2", "3", "4" ] },
      "expect": { "roots": [ "-3⌟4+√(23)⌟4i", "-3⌟4-√(23)⌟4i" ], "extremum": { "type": "Min", "x": "-3⌟4", "y": "23⌟8" } },
      "expectationSource": "derived-exact" },
    { "id": "equation-polynomial-003", "page": 118, "app": "Equation", "kind": "polynomial", "status": "ready",
      "settings": { "complexRoots": "Off" },
      "given": { "degree": 2, "coefficients": [ "2", "3", "4" ] },
      "expect": { "message": "NoRealRoots" }, "expectationSource": "manual" },
    { "id": "equation-solver-001", "page": 120, "app": "Equation", "kind": "solver", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO" },
      "given": { "equation": "x²-B²=0", "variables": { "B": "4" }, "solveFor": "x", "initialValue": "1" },
      "expect": { "solution": "4", "leftMinusRight": "0" }, "expectationSource": "derived-exact",
      "note": "Newton's method from x = 1 converges to the positive root." },

    { "id": "inequality-001", "page": 124, "app": "Inequality", "kind": "inequality", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO" },
      "given": { "degree": 2, "relation": "≥", "coefficients": [ "1", "2", "-3" ] },
      "expect": { "solution": "x≤-3, 1≤x" }, "expectationSource": "derived-exact" },
    { "id": "inequality-002", "page": 125, "app": "Inequality", "kind": "inequality", "status": "ready",
      "given": { "degree": 2, "relation": "<", "coefficients": [ "1", "0", "0" ] },
      "expect": { "message": "NoSolution" }, "expectationSource": "manual" },
    { "id": "inequality-003", "page": 125, "app": "Inequality", "kind": "inequality", "status": "ready",
      "given": { "degree": 2, "relation": "≥", "coefficients": [ "1", "0", "0" ] },
      "expect": { "message": "AllRealNumbers" }, "expectationSource": "manual" },

    { "id": "ratio-001", "page": 145, "app": "Ratio", "kind": "ratio", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO" },
      "given": { "form": "A:B=X:D", "A": "3", "B": "8", "D": "12" },
      "expect": { "X": "9⌟2" }, "expectationSource": "derived-exact" },
    { "id": "ratio-002", "page": 146, "app": "Ratio", "kind": "ratio", "status": "ready",
      "given": { "form": "A:B=X:D", "A": "1", "B": "2", "D": "10" },
      "expect": { "X": "5" }, "expectationSource": "derived-exact" },
    { "id": "ratio-zero-001", "page": 146, "app": "Ratio", "kind": "ratio", "status": "ready",
      "given": { "form": "A:B=X:D", "A": "0", "B": "2", "D": "10" },
      "expect": { "error": "MathError" }, "expectationSource": "manual" }
  ]
}
