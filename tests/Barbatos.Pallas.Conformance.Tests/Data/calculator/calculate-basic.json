{
  "source": "User's guide of the reference calculator, Vietnamese edition (SA2207-A)",
  "chapter": "Input rules, basic calculations, memory and result formats (pp. 28-50)",
  "cases": [
    { "id": "basic-precedence-001", "page": 28, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "4×sin(30)×(30+10×3)", "expect": { "result": "120" }, "expectationSource": "manual" },

    { "id": "basic-implicit-paren-001", "page": 29, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "6÷2(1+2)", "expect": { "equivalentTo": "6÷(2(1+2))", "result": "1" }, "expectationSource": "manual",
      "note": "The manual states the equivalence; the value follows exactly from it." },
    { "id": "basic-implicit-paren-002", "page": 29, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "6÷2π", "expect": { "equivalentTo": "6÷(2π)" }, "expectationSource": "manual" },

    { "id": "basic-arith-001", "page": 31, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "7×8-4×5", "expect": { "result": "36" }, "expectationSource": "manual" },

    { "id": "basic-fraction-001", "page": 32, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO" },
      "input": "2⌟3+1⌟1⌟2", "expect": { "result": "13⌟6" }, "expectationSource": "manual" },
    { "id": "basic-fraction-002", "page": 32, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "LineI/LineO" },
      "input": "2⌟3+1⌟1⌟2", "expect": { "result": "13⌟6" }, "expectationSource": "manual" },
    { "id": "basic-fraction-003", "page": 32, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "LineI/LineO" },
      "input": "1⌟1⌟123456", "expect": { "result": "123457⌟123456" }, "expectationSource": "manual",
      "note": "Ten digits including separators: still shown as a fraction." },
    { "id": "basic-fraction-004", "page": 33, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "LineI/LineO" },
      "input": "1⌟1⌟1234567", "expect": { "result": "1.00000081" }, "expectationSource": "manual",
      "note": "Eleven digits including separators: shown as a decimal in the Standard profile." },

    { "id": "basic-power-001", "page": 33, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "(5²)³", "expect": { "result": "15625" }, "expectationSource": "manual" },
    { "id": "basic-power-002", "page": 33, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "(1+1)^(2+2)", "expect": { "result": "16" }, "expectationSource": "manual" },
    { "id": "basic-root-001", "page": 33, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO" },
      "input": "√(2)×3", "expect": { "result": "3√(2)" }, "expectationSource": "manual" },
    { "id": "basic-root-002", "page": 33, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "LineI/LineO" },
      "input": "√(2)×3", "expect": { "result": "4.242640687" }, "expectationSource": "manual" },
    { "id": "basic-root-003", "page": 34, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "5ˣ√(32)", "expect": { "result": "2" }, "expectationSource": "manual" },
    { "id": "basic-reciprocal-001", "page": 34, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO" },
      "input": "10⁻¹", "expect": { "result": "1⌟10" }, "expectationSource": "manual" },
    { "id": "basic-exp10-001", "page": 34, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "1.23×10^3", "expect": { "result": "1230" }, "expectationSource": "manual" },

    { "id": "basic-surd-001", "page": 35, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO" },
      "input": "10√(2)+15×3√(3)", "expect": { "result": "45√(3)+10√(2)" }, "expectationSource": "manual" },
    { "id": "basic-surd-002", "page": 35, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO" },
      "input": "99√(999)", "expect": { "result": "3129.089165" }, "expectationSource": "manual",
      "note": "Exactly 297√(111), outside the surd display range (a < 100), so the Standard profile shows the decimal." },

    { "id": "basic-constant-pi-001", "page": 35, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/DecimalO" },
      "input": "π", "expect": { "result": "3.141592654" }, "expectationSource": "manual" },
    { "id": "basic-constant-e-001", "page": 35, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/DecimalO" },
      "input": "e", "expect": { "result": "2.718281828" }, "expectationSource": "manual" },

    { "id": "basic-history-001", "page": 35, "app": "Calculate", "kind": "sequence", "status": "ready",
      "steps": [
        { "input": "2+2", "expect": { "result": "4" } },
        { "input": "3+3", "expect": { "result": "6" } }
      ], "expectationSource": "manual" },
    { "id": "basic-replay-001", "page": 36, "app": "Calculate", "kind": "sequence", "status": "ready",
      "steps": [
        { "input": "4×3+2", "expect": { "result": "14" } },
        { "input": "4×3-7", "expect": { "result": "5" } }
      ], "expectationSource": "manual" },

    { "id": "basic-ans-001", "page": 37, "app": "Calculate", "kind": "sequence", "status": "ready",
      "steps": [
        { "input": "3×4", "expect": { "result": "12" } },
        { "input": "Ans÷30", "expect": { "result": "2⌟5" } }
      ], "expectationSource": "derived-exact" },
    { "id": "basic-ans-002", "page": 37, "app": "Calculate", "kind": "sequence", "status": "needs-visual-check",
      "steps": [
        { "input": "123+456", "expect": { "result": "579" } },
        { "input": "789-Ans", "expect": { "result": "210" } }
      ], "expectationSource": "derived-exact",
      "note": "The operators appear only as key icons in the text extraction; this is the manual's usual example. Confirm against p. 37." },
    { "id": "basic-preans-001", "page": 37, "app": "Calculate", "kind": "sequence", "status": "ready",
      "steps": [
        { "input": "1", "expect": { "result": "1" } },
        { "input": "1", "expect": { "result": "1" } },
        { "input": "Ans+PreAns", "expect": { "result": "2" } },
        { "input": "Ans+PreAns", "expect": { "result": "3" } },
        { "input": "Ans+PreAns", "expect": { "result": "5" } }
      ], "expectationSource": "manual", "note": "Fibonacci T1..T5 = {1, 1, 2, 3, 5}." },

    { "id": "basic-variable-001", "page": 38, "app": "Calculate", "kind": "sequence", "status": "ready",
      "steps": [
        { "input": "3+5", "store": "A", "expect": { "result": "8", "variables": { "A": "8" } } },
        { "input": "A×10", "expect": { "result": "80" } }
      ], "expectationSource": "derived-exact" },
    { "id": "basic-calc-001", "page": 40, "app": "Calculate", "kind": "calc", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO" },
      "input": "3A+B", "given": { "calcValues": { "A": "5", "B": "10" } },
      "expect": { "result": "25" }, "expectationSource": "derived-exact" },

    { "id": "format-number-fix-001", "page": 23, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "numberFormat": "Fix3" },
      "input": "1÷6", "expect": { "decimal": "0.167" }, "expectationSource": "derived-exact" },
    { "id": "format-number-sci-001", "page": 23, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "numberFormat": "Sci3" },
      "input": "1÷6", "expect": { "decimal": "1.67×10^-1" }, "expectationSource": "derived-exact" },
    { "id": "format-number-norm1-001", "page": 23, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "numberFormat": "Norm1" },
      "input": "1÷200", "expect": { "decimal": "5×10^-3" }, "expectationSource": "derived-exact",
      "note": "Norm 1 uses exponent form when |x| < 10^-2." },
    { "id": "format-number-norm2-001", "page": 24, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "numberFormat": "Norm2" },
      "input": "1÷200", "expect": { "decimal": "0.005" }, "expectationSource": "derived-exact",
      "note": "Norm 2 uses exponent form only when |x| < 10^-9." },

    { "id": "format-fraction-decimal-001", "page": 43, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO", "fractionResult": "Improper" },
      "input": "3÷2", "expect": { "result": "3⌟2", "decimal": "1.5", "mixedFraction": "1⌟1⌟2" }, "expectationSource": "manual" },
    { "id": "format-standard-decimal-001", "page": 44, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO" },
      "input": "π÷6", "expect": { "result": "1⌟6π", "decimal": "0.5235987756", "standard": "1⌟6π" }, "expectationSource": "manual" },
    { "id": "format-prime-factor-001", "page": 45, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "1014", "expect": { "primeFactor": "2×3×13²" }, "expectationSource": "derived-exact" },
    { "id": "format-prime-factor-002", "page": 45, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "2036162", "expect": { "primeFactor": "2×(1018081)" }, "expectationSource": "manual",
      "note": "The Standard profile leaves a prime factor >= 1018081 unfactored, in parentheses." },
    { "id": "format-prime-factor-003", "page": 45, "app": "Calculate", "kind": "expression", "status": "ready",
      "profile": "Extended",
      "input": "2036162", "expect": { "primeFactor": "2×1009²" }, "expectationSource": "derived-exact",
      "note": "Pallas extension: full factorization. 1018081 = 1009²." },
    { "id": "format-recurring-001", "page": 46, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO" },
      "input": "3.(021)+0.(312)", "expect": { "result": "10⌟3", "recurringDecimal": "3.(3)" }, "expectationSource": "derived-exact" },
    { "id": "format-mixed-001", "page": 47, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO", "fractionResult": "Improper" },
      "input": "13⌟4", "expect": { "result": "13⌟4", "mixedFraction": "3⌟1⌟4", "improperFraction": "13⌟4" }, "expectationSource": "manual" },
    { "id": "format-mixed-002", "page": 47, "app": "Calculate", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "LineI/LineO" },
      "input": "3.25", "expect": { "result": "3.25", "improperFraction": "13⌟4", "mixedFraction": "3⌟1⌟4" }, "expectationSource": "manual" },
    { "id": "format-eng-001", "page": 48, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "1234", "expect": { "eng": "1.234×10^3" }, "expectationSource": "derived-exact" },
    { "id": "format-sexagesimal-001", "page": 49, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "1.25", "expect": { "sexagesimal": "1°15′0″" }, "expectationSource": "manual" },
    { "id": "format-sexagesimal-002", "page": 49, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "2°20′30″+0°9′30″", "expect": { "result": "2°30′0″", "decimal": "2.5" }, "expectationSource": "derived-exact" }
  ]
}
