{
  "source": "User's guide of the reference calculator, Vietnamese edition (SA2207-A)",
  "chapter": "Complex and Base-N applications (pp. 125-132)",
  "cases": [
    { "id": "complex-arith-001", "page": 126, "app": "Complex", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO", "complexResult": "a+bi" },
      "input": "(1+i)^4+(1-i)^2", "expect": { "result": "-4-2i" }, "expectationSource": "manual" },
    { "id": "complex-polar-to-rect-001", "page": 126, "app": "Complex", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO", "angleUnit": "Degree", "complexResult": "a+bi" },
      "input": "2∠45", "expect": { "result": "√(2)+√(2)i" }, "expectationSource": "manual" },
    { "id": "complex-rect-to-polar-001", "page": 127, "app": "Complex", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO", "angleUnit": "Degree", "complexResult": "r∠θ" },
      "input": "√(2)+√(2)i", "expect": { "result": "2∠45" }, "expectationSource": "manual" },
    { "id": "complex-format-001", "page": 128, "app": "Complex", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO", "angleUnit": "Degree", "complexResult": "a+bi" },
      "input": "√(2)+√(2)i", "expect": { "result": "√(2)+√(2)i", "polar": "2∠45", "rectangular": "√(2)+√(2)i" }, "expectationSource": "manual" },
    { "id": "complex-conjugate-001", "page": 127, "app": "Complex", "kind": "expression", "status": "ready",
      "input": "Conjg(2+3i)", "expect": { "result": "2-3i" }, "expectationSource": "derived-exact" },
    { "id": "complex-abs-001", "page": 127, "app": "Complex", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO", "angleUnit": "Degree" },
      "input": "Abs(1+i)", "expect": { "result": "√(2)" }, "expectationSource": "derived-exact" },
    { "id": "complex-arg-001", "page": 127, "app": "Complex", "kind": "expression", "status": "ready",
      "settings": { "angleUnit": "Degree" },
      "input": "Arg(1+i)", "expect": { "result": "45" }, "expectationSource": "derived-exact" },
    { "id": "complex-real-part-001", "page": 127, "app": "Complex", "kind": "expression", "status": "ready",
      "input": "ReP(2+3i)", "expect": { "result": "2" }, "expectationSource": "derived-exact" },
    { "id": "complex-imaginary-part-001", "page": 127, "app": "Complex", "kind": "expression", "status": "ready",
      "input": "ImP(2+3i)", "expect": { "result": "3" }, "expectationSource": "derived-exact" },
    { "id": "complex-verify-001", "page": 128, "app": "Complex", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" },
      "input": "i²=-1", "expect": { "verify": "True" }, "expectationSource": "derived-exact" },
    { "id": "complex-verify-inequality-001", "page": 128, "app": "Complex", "kind": "expression", "status": "ready",
      "settings": { "verify": "On" },
      "input": "i<2", "expect": { "error": "MathError" }, "expectationSource": "manual",
      "note": "An inequality containing a complex number cannot be verified." },

    { "id": "basen-binary-001", "page": 129, "app": "BaseN", "kind": "expression", "status": "ready",
      "settings": { "baseMode": "Binary" },
      "input": "11+1", "expect": { "result": "100" }, "expectationSource": "derived-exact" },
    { "id": "basen-hex-001", "page": 129, "app": "BaseN", "kind": "expression", "status": "ready",
      "settings": { "baseMode": "Hexadecimal" },
      "input": "1F+1", "expect": { "result": "20" }, "expectationSource": "derived-exact" },
    { "id": "basen-prefix-001", "page": 131, "app": "BaseN", "kind": "expression", "status": "ready",
      "settings": { "baseMode": "Decimal" },
      "input": "d10+h10+b10+o10", "expect": { "result": "36" }, "expectationSource": "derived-exact" },
    { "id": "basen-convert-001", "page": 131, "app": "BaseN", "kind": "sequence", "status": "ready",
      "settings": { "baseMode": "Decimal" },
      "steps": [
        { "input": "15×37", "expect": { "result": "555" } },
        { "switchBaseMode": "Hexadecimal", "expect": { "result": "22B" } }
      ], "expectationSource": "derived-exact", "note": "Leading zeros of the 32-bit display are not part of the expectation." },
    { "id": "basen-and-001", "page": 131, "app": "BaseN", "kind": "expression", "status": "ready",
      "settings": { "baseMode": "Binary" },
      "input": "1010 and 1100", "expect": { "result": "1000" }, "expectationSource": "derived-exact" },
    { "id": "basen-not-001", "page": 132, "app": "BaseN", "kind": "expression", "status": "ready",
      "settings": { "baseMode": "Binary" },
      "input": "Not(1010)", "expect": { "result": "11111111111111111111111111110101", "decimalValue": "-11" }, "expectationSource": "derived-exact",
      "note": "32-bit two's complement." },
    { "id": "basen-range-001", "page": 130, "app": "BaseN", "kind": "expression", "status": "ready",
      "settings": { "baseMode": "Decimal" },
      "input": "2147483647+1", "expect": { "error": "MathError" }, "expectationSource": "manual",
      "note": "Decimal range is -2147483648 <= x <= 2147483647." }
  ]
}
