{
  "source": "User's guide of the reference calculator, Vietnamese edition (SA2207-A)",
  "chapter": "Math Box, errors and calculation priority (pp. 146-168)",
  "cases": [
    { "id": "mathbox-circle-001", "page": 160, "app": "MathBox", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO", "angleUnit": "Degree" },
      "input": "sin(45)", "expect": { "result": "√(2)⌟2" }, "expectationSource": "manual" },
    { "id": "mathbox-circle-002", "page": 160, "app": "MathBox", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO", "angleUnit": "Degree" },
      "input": "cos(30)", "expect": { "result": "√(3)⌟2" }, "expectationSource": "manual" },
    { "id": "mathbox-dice-range-001", "page": 164, "app": "MathBox", "kind": "property", "status": "ready",
      "given": { "simulation": "Dice Roll", "dice": 1, "attempts": "251" },
      "expect": { "error": "RangeError" }, "expectationSource": "manual", "note": "Attempts must be an integer from 1 to 250." },
    { "id": "mathbox-number-line-range-001", "page": 165, "app": "MathBox", "kind": "property", "status": "ready",
      "given": { "numberLine": "a<x≤b", "a": "10", "b": "5" },
      "expect": { "error": "RangeError" }, "expectationSource": "manual" },

    { "id": "error-divide-by-zero-001", "page": 162, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "14÷0×2", "expect": { "error": "MathError" }, "expectationSource": "manual" },
    { "id": "precedence-negation-001", "page": 169, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "-2²", "expect": { "result": "-4" }, "expectationSource": "manual",
      "note": "x² (priority 3) binds tighter than the negative sign (priority 5)." },
    { "id": "precedence-negation-002", "page": 169, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "(-2)²", "expect": { "result": "4" }, "expectationSource": "manual" }
  ]
}
