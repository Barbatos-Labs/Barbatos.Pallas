{
  "source": "User's guide of the reference calculator, Vietnamese edition (SA2207-A)",
  "chapter": "Math Box, errors and calculation priority (pp. 146-168)",
  "cases": [
    { "id": "mathbox-circle-001", "page": 160, "app": "MathBox", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO", "angleUnit": "Degree" },
      "input": "sin(45)", "expect": { "result": "√(2)⌟2" }, "expectationSource": "manual" },
    { "id": "mathbox-circle-002", "page": 160, "app": "MathBox", "kind": "expression", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO", "angleUnit": "Degree" },
      "input": "cos(30)", "expect": { "result": "√(3)⌟2" }, "expectationSource": "manual" },
    { "id": "mathbox-circle-003", "page": 157, "app": "MathBox", "kind": "mathbox", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO", "angleUnit": "Degree" },
      "given": { "circle": "Unit Circle", "angle": "45" },
      "expect": { "sin": "√(2)⌟2", "cos": "√(2)⌟2", "tan": "1" }, "expectationSource": "manual" },
    { "id": "mathbox-half-circle-range-001", "page": 159, "app": "MathBox", "kind": "mathbox", "status": "ready",
      "settings": { "angleUnit": "Degree" },
      "given": { "circle": "Half Circle", "angle": "181" },
      "expect": { "error": "RangeError" }, "expectationSource": "manual", "note": "The Half Circle takes 0 ≤ θ ≤ 180 in degrees." },
    { "id": "mathbox-clock-001", "page": 161, "app": "MathBox", "kind": "mathbox", "status": "ready",
      "settings": { "inputOutput": "MathI/MathO", "angleUnit": "Degree" },
      "given": { "clock": 3 },
      "expect": { "angles": ["90", "270"] }, "expectationSource": "manual" },
    { "id": "mathbox-dice-range-001", "page": 164, "app": "MathBox", "kind": "mathbox", "status": "ready",
      "given": { "simulation": "Dice Roll", "dice": 1, "attempts": "251" },
      "expect": { "error": "RangeError" }, "expectationSource": "manual", "note": "Attempts must be an integer from 1 to 250." },
    { "id": "mathbox-coin-range-001", "page": 164, "app": "MathBox", "kind": "mathbox", "status": "ready",
      "given": { "simulation": "Coin Toss", "coins": 2, "attempts": "2.5" },
      "expect": { "error": "RangeError" }, "expectationSource": "manual", "note": "An attempt count that is not a whole number." },
    { "id": "mathbox-number-line-range-001", "page": 165, "app": "MathBox", "kind": "mathbox", "status": "ready",
      "given": { "numberLine": "a<x≤b", "a": "10", "b": "5" },
      "expect": { "error": "RangeError" }, "expectationSource": "manual" },
    { "id": "mathbox-number-line-view-001", "page": 155, "app": "MathBox", "kind": "mathbox", "status": "ready",
      "given": { "numberLines": [
        { "numberLine": "x≤a", "a": "-1.5" },
        { "numberLine": "x>a", "a": "-1.0" },
        { "numberLine": "a<x≤b", "a": "-2.0", "b": "-0.5" } ] },
      "expect": { "view": { "scale": "0.2", "center": "-1.2", "minimum": "-2.8", "maximum": "0.4" } }, "expectationSource": "manual",
      "note": "The View-Window the calculator sets for these three expressions (p. 156); the rule behind it is assumption U29." },
    { "id": "mathbox-number-line-view-002", "page": 157, "app": "MathBox", "kind": "mathbox", "status": "ready",
      "given": { "viewWindow": { "scale": "1", "center": "2" } },
      "expect": { "view": { "scale": "1", "center": "2", "minimum": "-6", "maximum": "10" } }, "expectationSource": "manual" },
    { "id": "mathbox-number-line-view-range-001", "page": 165, "app": "MathBox", "kind": "mathbox", "status": "ready",
      "given": { "viewWindow": { "scale": "0.00000000001", "center": "0" } },
      "expect": { "error": "RangeError" }, "expectationSource": "manual", "note": "The scale takes 10⁻¹⁰ to 10¹⁰ (p. 157)." },

    { "id": "error-divide-by-zero-001", "page": 162, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "14÷0×2", "expect": { "error": "MathError" }, "expectationSource": "manual" },
    { "id": "precedence-negation-001", "page": 169, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "-2²", "expect": { "result": "-4" }, "expectationSource": "manual",
      "note": "x² (priority 3) binds tighter than the negative sign (priority 5)." },
    { "id": "precedence-negation-002", "page": 169, "app": "Calculate", "kind": "expression", "status": "ready",
      "input": "(-2)²", "expect": { "result": "4" }, "expectationSource": "manual" }
  ]
}
