<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The one test project that needs Windows: it renders with WpfMath, the renderer of the desktop application.
      * every LaTeX the printers emit is parsed and drawn by WpfMath, so "the app displays it" is measured rather
        than assumed (WpfMath has no \operatorname, and \# and \$ are commands only \text carries);
      * the session in the preferences.
    Plural TargetFrameworks even for one framework: a singular TargetFramework does not override the inherited
    plural form, it silently builds the inherited set (CLAUDE.md).
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.17763.0</TargetFrameworks>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WpfMath" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\app\Barbatos.Pallas.Wpf\Barbatos.Pallas.Wpf.csproj" />
  </ItemGroup>

</Project>
